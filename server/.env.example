# Copy this file to .env and fill in real values.
# `.env` is gitignored — never commit real secrets.

# Server
PORT=4000
NODE_ENV=development
# The deployed frontend origin (no trailing slash). Used for CORS, the auth
# cookie's cross-site settings, Stripe redirect URLs, and links in emails.
# In production this must be the exact Vercel URL, e.g. https://theladpad-v2.vercel.app
CLIENT_URL=http://localhost:5173

# Where the JSON database file lives. Leave unset for local dev (defaults to
# server/data/db.json). On a host with an ephemeral filesystem (e.g. Railway
# without a mounted volume), set this to a path inside a persistent volume,
# e.g. /data/db.json — otherwise bookings/staff changes are lost on redeploy.
DB_PATH=

# Auth — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Stripe webhook signing secret.
# Locally, run: stripe listen --forward-to localhost:4000/api/webhooks/stripe
# and paste the "whsec_..." value it prints. In production, create a webhook
# endpoint in the Stripe dashboard pointing at <your-api-url>/api/webhooks/stripe
# and copy its signing secret here.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email — defaults to logging emails to the console.
# Set to "smtp" and fill in the SMTP_* vars below to send real emails via
# any SMTP-compatible provider (Resend, SendGrid, Postmark, etc).
EMAIL_TRANSPORT=console
EMAIL_FROM=The Lad Pad Barbershop <bookings@theladpad.ie>
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
